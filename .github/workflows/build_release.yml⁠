name: Build and Release APK

on:
  push:
    tags:
      - 'v*'
  workflow_dispatch:

jobs:
  build:
    name: Build Flutter APK and Release
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: 'stable'
          cache: true

      - name: Install dependencies
        run: |
          cd live_tv
          flutter pub get

      - name: Make script executable
        run: |
          if [ -f "live_tv/build_apk.sh" ]; then
            chmod +x live_tv/build_apk.sh
          fi

      - name: Build APK release
        run: |
          cd live_tv
          flutter build apk --release --split-per-abi

      - name: Upload to GitHub Releases
        uses: softprops/action-gh-release@v1
        if: startsWith(github.ref, 'refs/tags/')
        with:
          files: |
            live_tv/build/app/outputs/flutter-apk/app-release.apk
            live_tv/build/app/outputs/flutter-apk/app-armeabi-v7a-release.apk
            live_tv/build/app/outputs/flutter-apk/app-arm64-v8a-release.apk
            live_tv/build/app/outputs/flutter-apk/app-x86_64-release.apk
          draft: false
          prerelease: false
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
